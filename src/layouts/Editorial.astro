---
import LanguageSwitch from '../components/LanguageSwitch.astro';
import {isLocale} from '../i18n/locales';
import {ui} from '../i18n/ui';
import {pageAlternates,defaultPagePath,productsPath,type PageId} from '../i18n/pages';
import { ClientRouter } from 'astro:transitions';
import '@fontsource-variable/literata';
import '@fontsource-variable/manrope';
import '../styles/editorial.css';
import { preview, privatePreview } from '../lib/content';
import sun from 'lucide-static/icons/sun.svg?raw';
import moon from 'lucide-static/icons/moon.svg?raw';
import monitor from 'lucide-static/icons/monitor.svg?raw';
const { title, description, lang='en', noindex=false, structured, article=false, translationKey } = Astro.props;
const locale=isLocale(lang)?lang:'en';
const text=ui[locale];
const alternatives=pageAlternates(translationKey as PageId|undefined);
const defaultPath=translationKey?defaultPagePath(translationKey):undefined;
const externalLanguage=locale==='en'?'':' (EN)';
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const schema = structured ?? { '@context':'https://schema.org', '@type':'Organization', name:'Dilum Labs', url:'https://dilum.io/' };
const path = Astro.url.pathname;
const navigation = [
  {label:text.products,url:productsPath(locale),translated:true,active:path.startsWith('/products/')||['/2000nl/','/audiofilms/','/pontix/'].includes(path)||/^\/[a-z]{2}\/(products|2000nl|audiofilms|pontix)\/$/.test(path)},
  {label:text.journal,url:'/blog/',active:path.startsWith('/blog/')},
  {label:text.people,url:'/authors/',active:path.startsWith('/authors/')},
  {label:text.contact,url:'/contact/',active:path.startsWith('/contact/')},
];
const themes = [{id:'system',icon:monitor},{id:'light',icon:sun},{id:'dark',icon:moon}];
---
<!doctype html>
<html lang={lang}>
<head>
<meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
<title>{title} · Dilum Labs</title><meta name="description" content={description}/>
<link rel="canonical" href={canonical}/>
{alternatives.map(([code,url])=><link rel="alternate" hreflang={code} href={new URL(url,Astro.site).href}/>)}
{defaultPath&&<link rel="alternate" hreflang="x-default" href={new URL(defaultPath,Astro.site).href}/>}<meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:type" content={article?'article':'website'}/>
<meta property="og:site_name" content="Dilum Labs"/>
{(preview || noindex) && <meta name="robots" content="noindex,nofollow"/>}
<link rel="alternate" type="application/rss+xml" title="Dilum Journal" href="/rss.xml"/>
<link rel="icon" type="image/svg+xml" href="/icon.svg"/>
<script is:inline defer src="https://cloud.umami.is/script.js" data-website-id="09001b3a-0258-4183-84ba-068e3a3a843b" data-domains="dilum.io"></script>
<ClientRouter fallback="swap"/>
<script is:inline>
(() => { let theme='system';try { const saved=localStorage.getItem('dilum-theme');if(['system','light','dark'].includes(saved))theme=saved; } catch {}
 document.documentElement.dataset.theme=theme;
 document.documentElement.dataset.scheme=theme==='system'?(matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light'):theme;
})();
</script>
<script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g,'\u003c')}/>
</head>
<body transition:animate="none">
<a class="skip" href="#main">{text.skip}</a>
<div class="header-space" aria-hidden="true"></div>
<div class="site-header" transition:persist={`studio-header-${locale}-${translationKey??'none'}`}>
{preview && <div class="preview-banner">{privatePreview?text.previewPrivate:text.previewPublic} <span aria-hidden="true">·</span> {privatePreview?text.privateOnly:text.publishedOnly}</div>}
<header class="masthead">
  <a class="brand" href="/" aria-label={text.home}>dilum<span>io</span><small>{text.brand}</small></a>
  <nav aria-label={text.navigation}>{navigation.map(item=><a href={item.url} aria-current={item.active?'page':undefined}>{item.label}{locale!=='en'&&!('translated' in item)&&<span class="nav-language" lang="en" title={text.english}>EN</span>}</a>)}</nav>
  <LanguageSwitch pageId={translationKey} locale={locale}/>
  <button class="theme-cycle" type="button" data-theme-cycle aria-label={text.themePrompt.replace('{current}',text.themeSystem).replace('{next}',text.themeLight)} title={text.themePrompt.replace('{current}',text.themeSystem).replace('{next}',text.themeLight)}>
    {themes.map(theme=><span data-theme-icon={theme.id} aria-hidden="true" set:html={theme.icon}/>)}
  </button>
</header>
</div>
<main id="main"><slot/></main>
<footer class="site-footer" id="contact">
  <div class="footer-contact-row"><p>Dilum Labs · Rotterdam</p><a class="contact-link" href="mailto:contact@dilum.io">contact@dilum.io ↗</a></div>
  <div class="footer-bottom"><p>© 2026 Dilum Labs</p><nav aria-label={text.footer}><a href="/contact/">{text.contact}{externalLanguage}</a><a href="/contact/#company-details">{text.company}{externalLanguage}</a><a href="https://www.linkedin.com/in/khrustalev/">LinkedIn</a><a href="https://github.com/vbalashi">GitHub</a><a href="/rss.xml">RSS</a></nav></div>
</footer>
<script>import '../scripts/navigation';</script>
</body>
</html>
