---
import Editorial from '../../layouts/Editorial.astro';import {authors,visibleArticles} from '../../lib/content';
export function getStaticPaths(){return authors.map(person=>({params:{author:person.slug},props:{person}}));}
const {person}=Astro.props;const articles=(await visibleArticles()).filter(a=>a.data.author===person.slug);const structured={'@context':'https://schema.org','@type':'Person',name:person.name,description:person.bio,url:`https://dilum.io/authors/${person.slug}/`,...(person.link?{sameAs:[person.link]}:{})};
---
<Editorial title={person.name} description={person.bio} structured={structured}><section class="wrap"><p class="eyebrow">{person.role}</p><h1 class="display">{person.name}</h1><p class="intro">{person.bio}</p>{person.link&&<p><a class="text-link" href={person.link}>LinkedIn ↗</a></p>}<h2>Writing</h2>{articles.map(a=><article class="person"><h2 lang={a.data.lang}><a href={`/journal/${a.data.slug}/`}>{a.data.title}</a></h2><p lang={a.data.lang}>{a.data.description}</p></article>)}{articles.length===0&&<p class="empty">Articles will appear here as they are published.</p>}<a href="/authors/">← People</a></section></Editorial>
