---
import {render} from 'astro:content';
import Editorial from '../../layouts/Editorial.astro';
import {visibleArticles,authors,topics,dateLabel} from '../../lib/content';
export async function getStaticPaths(){return (await visibleArticles()).map(entry=>({params:{slug:entry.data.slug},props:{entry}}));}
const {entry}=Astro.props;const {Content}=await render(entry);const a=entry.data;
const author=authors.find(p=>p.slug===a.author)!;const topic=topics.find(t=>t.slug===a.category)!;
const structured={'@context':'https://schema.org','@type':'BlogPosting',headline:a.title,description:a.description,inLanguage:a.lang,datePublished:a.date.toISOString(),...(a.updated?{dateModified:a.updated.toISOString()}:{}),author:{'@type':'Person',name:author.name,url:`https://dilum.io/authors/${author.slug}/`},publisher:{'@type':'Organization',name:'Dilum Labs',url:'https://dilum.io/'},mainEntityOfPage:`https://dilum.io/journal/${a.slug}/`};
---
<Editorial title={a.title} description={a.description} lang={a.lang} noindex={a.draft} structured={a.draft?undefined:structured} article>
<header class="article-head"><p class="eyebrow"><a href={`/journal/topics/${topic.slug}/`}>{topic.name}</a></p>{a.draft&&<p class="draft-label">Редакционный черновик · текст ещё обсуждается</p>}<h1>{a.title}</h1><p class="dek">{a.description}</p><div class="byline"><a href={`/authors/${author.slug}/`}>{author.name}</a> · {dateLabel(a.date,a.lang)} · {Math.max(1,Math.ceil((entry.body?.split(/\s+/).length||0)/180))} min read</div></header>
<article class="reading"><Content/></article>
<aside class="article-end">{a.products.length>0&&<p>Related products: {a.products.map(p=><a href={`/products/${p}/`}>{p==='2000nl'?'2000 NL':p==='audiofilms'?'AudioFilms':'Pontix'} </a>)}</p>}{a.crossposts.length>0&&<p>Also published on: {a.crossposts.map(c=><a href={c.url} rel="noopener">{c.platform} </a>)}</p>}<a href="/journal/">← All articles</a></aside>
</Editorial>
