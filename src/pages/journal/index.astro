---
import Editorial from '../../layouts/Editorial.astro';
import {visibleArticles,topics,authors,dateLabel} from '../../lib/content';
const articles=await visibleArticles();
---
<Editorial title="Journal" description="Stories about the products we build, the work behind them, and learning along the way.">
<section class="wrap"><p class="eyebrow">The Dilum Journal</p><h1 class="display">A place for<br/>what we learn.</h1><p class="intro">Stories from building our products. Notes from professional practice. And the everyday work of an independent studio.</p>
<nav class="topic-nav" aria-label="Journal topics"><a href="/journal/" aria-current="page">All articles</a>{topics.map(t=><a href={`/journal/topics/${t.slug}/`}>{t.name}</a>)}</nav>
{articles.length===0&&<p class="empty">Our first articles are in preparation. Come back soon, or <a href="/#projects">explore our products</a>.</p>}
{articles.map(a=><article class="story-card"><div class="meta"><span>{topics.find(t=>t.slug===a.data.category)?.name}</span><br/><span>{dateLabel(a.data.date)}</span><br/><span>{a.data.lang==='ru'?'In Russian':'In English'}</span>{a.data.draft&&<span class="draft-label">Working draft</span>}</div><div><h2 lang={a.data.lang}><a href={`/journal/${a.data.slug}/`}>{a.data.title}</a></h2><p lang={a.data.lang}>{a.data.description}</p><p>By <a href={`/authors/${a.data.author}/`}>{authors.find(p=>p.slug===a.data.author)?.name}</a></p><a class="text-link" href={`/journal/${a.data.slug}/`}>Read the story →</a></div></article>)}
</section></Editorial>
