---
import ProductsIndex from '../../components/ProductsIndex.astro';
import {localeCodes,defaultLocale} from '../../i18n/locales';
export function getStaticPaths(){return localeCodes.filter(locale=>locale!==defaultLocale).map(locale=>({params:{locale},props:{locale}}));}
const {locale}=Astro.props;
---
<ProductsIndex locale={locale}/>
