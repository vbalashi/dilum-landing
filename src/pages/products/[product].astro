---
import Editorial from '../../layouts/Editorial.astro';import {products,visibleArticles} from '../../lib/content';
export function getStaticPaths(){return products.map(product=>({params:{product:product.slug},props:{product}}));}
const {product}=Astro.props;const articles=(await visibleArticles()).filter(a=>a.data.products.includes(product.slug));
---
<Editorial title={product.name} description={product.description}><section class="wrap"><p class="eyebrow">{product.kind} / {product.status}</p><h1 class="display">{product.name}</h1><p class="intro">{product.description}</p><p class="intro">{product.detail}</p>{product.url&&<p><a class="text-link" href={product.url}>{product.cta} ↗</a></p>}<h2>Stories behind the product</h2>{articles.map(a=><article class="person"><h2 lang={a.data.lang}><a href={`/journal/${a.data.slug}/`}>{a.data.title}</a></h2></article>)}{articles.length===0&&<p class="empty">Product stories are being prepared.</p>}<a href="/#projects">← All products</a></section></Editorial>
