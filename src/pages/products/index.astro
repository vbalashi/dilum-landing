---
import Editorial from '../../layouts/Editorial.astro';
import {products} from '../../lib/content';
---
<Editorial title="Products" description="The digital products we are building at Dilum Labs.">
<section class="wrap"><h1 class="display">Our products</h1><p class="intro">Learning is our first focus. These connected projects approach vocabulary through practice, video, and the words we encounter.</p>
{products.map((product,index)=><article class="project-entry"><span class="project-number">0{index+1}</span><div><p class="eyebrow">{product.kind}</p><h2><a href={`/products/${product.slug}/`}>{product.name}</a></h2><p class="status">{product.status}</p></div><p class="project-description">{product.description}</p><a class="project-arrow" href={`/products/${product.slug}/`} aria-label={`Explore ${product.name}`}>↗</a></article>)}
</section></Editorial>
