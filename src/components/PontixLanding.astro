---
import {productCopy} from '../i18n/products';
import {ui} from '../i18n/ui';
import {productPath} from '../i18n/pages';
import type {Locale} from '../i18n/locales';
const {locale='en'}=Astro.props as {locale?:Locale};
const copy=productCopy['pontix'][locale];
---
<div class="nl-landing pontix-landing">
 <nav class="breadcrumbs" aria-label={copy.breadcrumbsLabel}><a href="/products/">{ui[locale].products}{locale!=='en'&&' (EN)'}</a><span aria-hidden="true">/</span><span aria-current="page">Pontix</span></nav>
 <header class="nl-hero">
  <div class="pontix-identity"><img src="/images/pontix/icon.png" width="64" height="64" alt=""/><p class="nl-wordmark">Pontix<small>{copy.tagline}</small></p></div>
  <p class="eyebrow">{copy.status}</p>
  <h1>{copy.heroFirst}<br/><em>{copy.heroSecond}</em></h1>
  <p class="nl-lead">{copy.lead}</p>
  <div class="nl-actions"><a class="nl-button" href="mailto:contact@dilum.io?subject=Pontix">{copy.ask}<span aria-hidden="true">↗</span></a><a class="nl-secondary" href={productPath('2000nl',locale)}>{copy.explore}</a></div>
  <p class="nl-access">{copy.access}</p>
 </header>
 <section class="nl-steps" aria-label={copy.stepsLabel}>
  <div><p class="eyebrow">{copy.readStep}</p><h2>{copy.readTitle}</h2><p>{copy.readBody}</p></div>
  <div><p class="eyebrow">{copy.understandStep}</p><h2>{copy.understandTitle}</h2><p>{copy.understandBody}</p></div>
  <div><p class="eyebrow">{copy.connectStep}</p><h2>{copy.connectTitle}</h2><p>{copy.connectBody}</p></div>
 </section>
 <section class="af-status"><p class="eyebrow">{copy.connectedEyebrow}</p><h2>{copy.connectedTitleFirst}<br/>{copy.connectedTitleSecond}</h2><p>{copy.connectedFirst}<a href={productPath('audiofilms',locale)}>AudioFilms</a>{copy.connectedMiddle}<a href={productPath('2000nl',locale)}>2000nl</a>.</p><p>{copy.connectedLast}<a href="/blog/">{copy.journal}</a>.</p></section>
</div>
