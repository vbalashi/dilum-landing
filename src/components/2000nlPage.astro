---
import Editorial from '../layouts/Editorial.astro';
import Landing from './2000nlLanding.astro';
import '../styles/2000nl.css';
import '../styles/audiofilms.css';
import {nlCopy} from '../i18n/products/2000nl';
import {ui} from '../i18n/ui';
import {translatedPages} from '../i18n/pages';
import type {Locale} from '../i18n/locales';
import {visibleArticles} from '../lib/content';
const {locale='en'}=Astro.props as {locale?:Locale};
const copy=nlCopy[locale]; const text=ui[locale];
const articles=(await visibleArticles()).filter(a=>a.data.products.includes('2000nl')&&a.data.lang===locale);
const structured={'@context':'https://schema.org','@type':'SoftwareApplication',name:'2000 NL',url:new URL(translatedPages['product.2000nl'][locale]!,Astro.site).href,description:copy.metaDescription,inLanguage:locale,applicationCategory:'EducationalApplication',creator:{'@type':'Organization',name:'Dilum Labs',url:'https://dilum.io/'}};
---
<Editorial title={copy.metaTitle} description={copy.metaDescription} lang={locale} translationKey="product.2000nl" structured={structured}>
<section class="wrap product-landing"><Landing locale={locale}/>
<section class="product-writing"><h2>{text.writing}</h2>{articles.map(a=><article class="person"><h3><a href={`/blog/${a.data.slug}/`}>{a.data.title}</a></h3><p>{a.data.description}</p></article>)}{articles.length===0&&<p class="empty">{text.writingEmpty} <a href="/blog/">{text.visitJournal}{locale!=='en'&&' (EN)'} →</a></p>}</section></section>
</Editorial>
