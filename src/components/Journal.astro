---
import {visibleArticles,topics,authors,dateLabel} from '../lib/content';
const {selected=''}=Astro.props;
const articles=await visibleArticles();
const count=articles.filter(a=>!selected||a.data.category===selected).length;
---
<section class="wrap journal" data-journal transition:persist="journal-archive">
  <header class="journal-heading"><h1>Journal</h1><p>Products, practice, and life in an independent studio.</p></header>
  <nav class="topic-nav" aria-label="Journal topics">
    <a href="/journal/" data-journal-topic="" aria-current={!selected?'page':undefined}>All articles</a>
    {topics.map(t=><a href={`/journal/topics/${t.slug}/`} data-journal-topic={t.slug} aria-current={selected===t.slug?'page':undefined}>{t.name}</a>)}
  </nav>
  <p class="sr-only" data-journal-status role="status">{count} {count===1?'article':'articles'}</p>
  <div class="journal-results">
    {articles.map(a=><article class="story-card" data-article-topic={a.data.category} hidden={!!selected&&selected!==a.data.category}>
      <div class="meta"><span>{topics.find(t=>t.slug===a.data.category)?.name}</span><span>{dateLabel(a.data.date)}</span><span>{a.data.lang==='ru'?'In Russian':'In English'}</span>{a.data.draft&&<span class="draft-label">Working draft</span>}</div>
      <div><h2 lang={a.data.lang}><a href={`/journal/${a.data.slug}/`}>{a.data.title}</a></h2><p lang={a.data.lang}>{a.data.description}</p><p>By <a href={`/authors/${a.data.author}/`}>{authors.find(p=>p.slug===a.data.author)?.name}</a></p><a class="text-link" href={`/journal/${a.data.slug}/`}>Read the story →</a></div>
    </article>)}
    <p class="empty" data-journal-empty hidden={count>0}>No articles in this selection yet. <a href="/journal/" data-journal-topic="">View all articles</a> or <a href="/products/">explore our products</a>.</p>
  </div>
</section>
