---
import {ui} from '../i18n/ui';
import Waitlist from './Waitlist.astro';
import { nlCopy } from '../i18n/products/2000nl';
import {productPath,productsPath} from '../i18n/pages';
import type { Locale } from '../i18n/locales';
const {locale='en'} = Astro.props as {locale?:Locale};
const copy = nlCopy[locale];
---
<div class="nl-landing">
 <nav class="breadcrumbs" aria-label={copy.breadcrumbsLabel}><a href={productsPath(locale)}>{ui[locale].products}</a><span aria-hidden="true">/</span><span aria-current="page">2000nl</span></nav>
 <header class="nl-hero">
  <p class="nl-wordmark">2000<span>nl</span><small>{copy.tagline}</small></p>
  <p class="eyebrow">{copy.status}</p>
  <h1>{copy.heroFirst}<br/><em>{copy.heroSecond}</em></h1>
  <p class="nl-lead">{copy.lead}</p>
  <div class="nl-actions"><a class="nl-button" href="#waitlist">{copy.join}<span aria-hidden="true">↗</span></a><a class="nl-secondary" href="#inside">{copy.explore}<span aria-hidden="true">↓</span></a></div>
  <p class="nl-access">{copy.access}<a href="https://2000.dilum.io/">{copy.signIn}</a></p>
 </header>
 <figure class="nl-showcase" id="inside">
  <div class="nl-library-shot"><img src="/images/2000nl/library.jpg" alt={copy.libraryAlt} width="1160" height="780" fetchpriority="high"/></div>
  <div class="nl-card-shot"><img src="/images/2000nl/dictionary-card.jpg" alt={copy.cardAlt} width="690" height="710"/></div>
 </figure>
 <section class="nl-steps" aria-label={copy.stepsLabel}>
  <div><p class="eyebrow">{copy.discoverStep}</p><h2>{copy.discoverTitle}</h2><p>{copy.discoverBody}</p></div>
  <div><p class="eyebrow">{copy.practiceStep}</p><h2>{copy.practiceTitle}</h2><p>{copy.practiceBody}</p></div>
  <div><p class="eyebrow">{copy.rememberStep}</p><h2>{copy.rememberTitle}</h2><p>{copy.rememberBody}</p></div>
 </section>
 <section class="nl-feature">
  <div class="nl-feature-copy"><p class="eyebrow">{copy.builderEyebrow}</p><h2>{copy.builderTitleFirst}<br/>{copy.builderTitleSecond}</h2><p>{copy.builderBody}</p><p>{copy.builderMore}</p><a class="nl-secondary" href="#waitlist">{copy.feedback}</a></div>
  <figure class="nl-screen nl-builder"><img src="/images/2000nl/session-builder.jpg" alt={copy.builderAlt} width="785" height="800" loading="lazy"/><figcaption>{copy.builderCaption}</figcaption></figure>
 </section>
 <section class="nl-feature nl-feature-reverse">
  <figure class="nl-screen nl-training"><img src="/images/2000nl/training.jpg" alt={copy.trainingAlt} width="790" height="795" loading="lazy"/><figcaption>{copy.trainingCaption}</figcaption></figure>
  <div class="nl-feature-copy"><p class="eyebrow">{copy.contextEyebrow}</p><h2>{copy.contextTitleFirst}<br/>{copy.contextTitleSecond}<br/>{copy.contextTitleThird}</h2><p>{copy.contextBody}</p><p>{copy.contextMore}</p></div>
 </section>
 <section class="nl-language-support"><p class="eyebrow">{copy.supportEyebrow}</p><h2>{copy.supportTitleFirst}<br/>{copy.supportTitleSecond}</h2><p>{copy.supportBody}</p><p>{copy.supportCaution}</p><p class="nl-roadmap"><strong>{copy.plannedLabel}</strong>{copy.plannedBody}</p></section>
 <section class="nl-connected-product"><div><p class="eyebrow">{copy.audiofilmsStatus}</p><h2>{copy.audiofilmsTitleFirst}<br/>{copy.audiofilmsTitleSecond}</h2><p>{copy.audiofilmsBody}</p><a class="nl-secondary" href={productPath('audiofilms',locale)}>{copy.audiofilmsLink}</a></div><figure><a href={productPath('audiofilms',locale)} aria-label={copy.audiofilmsLabel}><img src="/images/audiofilms/youtube-workspace.jpg" width="1590" height="825" loading="lazy" alt={copy.audiofilmsAlt}/></a></figure></section>
 <p class="nl-access">{copy.pontixIntro}<a href={productPath('pontix',locale)}>Pontix</a>{copy.pontixBody}</p>
 <Waitlist locale={locale} cta={copy.join.trim()}/>
 <section class="nl-faq" aria-label={copy.faqLabel}>
  <p class="eyebrow">{copy.faqEyebrow}</p>
  <details><summary>{copy.faqAccessTitle}</summary><p>{copy.faqAccessFirst}<a href="https://2000.dilum.io/">{copy.faqAccessLink}</a>{copy.faqAccessLast}</p></details>
  <details><summary>{copy.faqLanguagesTitle}</summary><p>{copy.faqLanguagesBody}</p></details>
  <details><summary>{copy.faqTestingTitle}</summary><p>{copy.faqTestingBody}</p></details>
 </section>
</div>
