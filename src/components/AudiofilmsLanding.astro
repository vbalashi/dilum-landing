---
import {productCopy} from '../i18n/products';
import {ui} from '../i18n/ui';
import {productPath} from '../i18n/pages';
import type {Locale} from '../i18n/locales';
const {locale='en'}=Astro.props as {locale?:Locale};
const copy=productCopy['audiofilms'][locale];
---
<div class="nl-landing af-landing">
 <nav class="breadcrumbs" aria-label={copy.breadcrumbsLabel}><a href="/products/">{ui[locale].products}{locale!=='en'&&' (EN)'}</a><span aria-hidden="true">/</span><span aria-current="page">AudioFilms</span></nav>
 <header class="nl-hero">
  <p class="nl-wordmark af-wordmark">Audio<span>Films</span><small>{copy.tagline}</small></p>
  <p class="eyebrow">{copy.status}</p>
  <h1>{copy.heroFirst}<br/><em>{copy.heroSecond}</em></h1>
  <p class="nl-lead">{copy.lead}</p>
  <div class="nl-actions"><a class="nl-button" href="#af-preview">{copy.explore}<span aria-hidden="true">↓</span></a><a class="nl-secondary" href="mailto:contact@dilum.io?subject=AudioFilms%20early%20testing">{copy.testingCTA}</a></div>
  <p class="nl-access">{copy.access}</p>
 </header>
 <figure class="af-workspace" id="af-preview">
  <img src="/images/audiofilms/youtube-workspace.jpg" width="1590" height="825" fetchpriority="high" alt={copy.workspaceAlt}/>
  <figcaption>{copy.captionFirst}<a href="https://www.youtube.com/watch?v=W2QGZdlXuBg">LUBACH</a>{copy.captionLast}</figcaption>
 </figure>
 <section class="nl-steps" aria-label={copy.stepsLabel}>
  <div><p class="eyebrow">{copy.listenStep}</p><h2>{copy.listenTitle}</h2><p>{copy.listenBody}</p></div>
  <div><p class="eyebrow">{copy.understandStep}</p><h2>{copy.understandTitle}</h2><p>{copy.understandBody}</p></div>
  <div><p class="eyebrow">{copy.keepStep}</p><h2>{copy.keepTitle}</h2><p>{copy.keepBody}</p></div>
 </section>
 <section class="af-phrase-feature">
  <div class="nl-feature-copy"><p class="eyebrow">{copy.phraseEyebrow}</p><h2>{copy.phraseTitleFirst}<br/>{copy.phraseTitleSecond}</h2><p>{copy.phraseBody}</p><p>{copy.phraseMore}</p></div>
  <figure class="af-ribbon-shot"><img src="/images/audiofilms/phrase-ribbon.jpg" width="1002" height="208" loading="lazy" alt={copy.ribbonAlt}/></figure>
 </section>
 <section class="nl-feature af-dictionary-feature">
  <div class="nl-feature-copy"><p class="eyebrow">{copy.dictionaryEyebrow}</p><h2>{copy.dictionaryTitleFirst}<br/>{copy.dictionaryTitleSecond}</h2><p>{copy.dictionaryFirst}<a href={productPath('2000nl',locale)}>2000nl</a>{copy.dictionaryLast}</p><p>{copy.dictionaryMore}</p><a class="nl-secondary" href={productPath('2000nl',locale)}>{copy.dictionaryLink}</a></div>
  <figure class="af-dictionary-shot"><img src="/images/audiofilms/dictionary-lookup.jpg" width="435" height="285" loading="lazy" alt={copy.dictionaryAlt}/></figure>
 </section>
 <section class="af-status"><p class="eyebrow">{copy.statusEyebrow}</p><h2>{copy.statusTitleFirst}<br/>{copy.statusTitleSecond}</h2><p>{copy.statusBody}</p><p>{copy.statusMore}<a href="mailto:contact@dilum.io?subject=AudioFilms%20early%20testing">{copy.statusContact}</a></p></section>
</div>
