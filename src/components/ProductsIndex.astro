---
import Editorial from '../layouts/Editorial.astro';
import {products} from '../lib/content';
import {catalogCopy} from '../i18n/catalog';
import {productPath,type ProductId} from '../i18n/pages';
import type {Locale} from '../i18n/locales';
const {locale='en'}=Astro.props as {locale?:Locale};
const copy=catalogCopy[locale];
const entries=[
 {...products[0],kind:copy.nlKind,status:copy.nlStatus,description:copy.nlDescription},
 {...products[1],kind:copy.audioKind,status:copy.audioStatus,description:copy.audioDescription},
 {...products[2],kind:copy.pontixKind,status:copy.pontixStatus,description:copy.pontixDescription},
];
---
<Editorial title={copy.metaTitle} description={copy.metaDescription} lang={locale} translationKey="page.products">
<section class="wrap"><h1 class="display">{copy.heading}</h1><p class="intro">{copy.intro}</p>
{entries.map((product,index)=><article class="project-entry"><span class="project-number">0{index+1}</span><div><p class="eyebrow">{product.kind}</p><h2><a href={productPath(product.slug as ProductId,locale)}>{product.name}</a></h2><p class="status">{product.status}</p></div><p class="project-description">{product.description}</p><a class="project-arrow" href={productPath(product.slug as ProductId,locale)} aria-label={copy.explore.replace('{product}',product.name)}>↗</a></article>)}
</section></Editorial>
