---
import { preview } from '../lib/content';
import {waitlistCopy} from '../i18n/ui/waitlist';
import type {Locale} from '../i18n/locales';
const {locale='en',cta}=Astro.props as {locale?:Locale;cta?:string};
const text=waitlistCopy[locale];
---
<section class="waitlist-section" id="waitlist" aria-labelledby="waitlist-title">
  <div><p class="eyebrow">{text.eyebrow}</p><h2 id="waitlist-title">{text.title}</h2>
  <p>{text.intro}</p></div>
  <form class="waitlist-form" data-waitlist data-locale={locale} data-messages={JSON.stringify({preview:text.preview,sending:text.sending,success:text.success,error:text.error,offline:text.offline})} data-preview={preview || import.meta.env.DEV?'true':'false'}>
    <label for="waitlist-email">{text.email}</label>
    <input id="waitlist-email" name="email" type="email" autocomplete="email" placeholder="you@example.com" required maxlength="254"/>
    <label for="waitlist-language">{text.language}</label>
    <input id="waitlist-language" name="language" type="text" placeholder={text.languagePlaceholder} required maxlength="80"/>
    <fieldset><legend>{text.interests} <span>{text.optional}</span></legend>
      {['Video practice','Reading & translation','Flashcards'].map(interest=><label class="waitlist-choice"><input type="checkbox" name="interests" value={interest}/><span>{({'Video practice':text.video,'Reading & translation':text.reading,Flashcards:text.flashcards})[interest]}</span></label>)}
    </fieldset>
    <label class="waitlist-choice"><input type="checkbox" name="earlyTester"/><span>{text.testing}</span></label>
    <div class="waitlist-trap" aria-hidden="true"><label for="waitlist-website">Website</label><input id="waitlist-website" name="website" tabindex="-1" autocomplete="off"/></div>
    <button class="waitlist-submit" type="submit">{cta??text.cta}</button>
    <p class="waitlist-message" role="status" aria-live="polite"></p>
    <p class="waitlist-privacy">{text.privacy} <a href="mailto:nik@dilum.io">nik@dilum.io</a>.</p>
    <noscript><p>{text.noscript} <a href="mailto:nik@dilum.io">{text.contact}</a>.</p></noscript>
  </form>
</section>
<script>import '../scripts/waitlist';</script>
