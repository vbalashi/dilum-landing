---
import '../styles/portfolio.css';
import arrow from 'lucide-static/icons/arrow-up-right.svg?raw';
import download from 'lucide-static/icons/download.svg?raw';
import plus from 'lucide-static/icons/plus.svg?raw';
const projects = [
 {number:'01',name:'Document intelligence',category:'Energy sector · OpenText',description:'From twelve possible use cases to a focused proof of concept.',detail:'Helped an energy company in the Netherlands evaluate document intelligence, select a practical starting scope and test the platform against its needs.',role:'Technical configuration & demonstrations · Shared use-case prioritisation',context:'OpenText',experience:'role-opentext',task:'Evaluate the platform against around twelve candidate use cases and agree on a feasible initial scope.',contribution:'Worked with the team and customer to prioritise four use cases. Personally configured the demonstration platform, tested scenarios on test data and explained platform capabilities and limitations.',outcome:'The customer accepted the proof of concept and purchased a platform licence. Their team began configuring the platform independently, with periodic on-the-job guidance.',tools:'Knowledge Discovery · PDF analysis · Regular expressions',source:'exp_opentext_energy_poc_adoption'},
 {number:'02',name:'Wi-Fi performance analytics',category:'Liberty Global · Via EPAM · 2021–2023',description:'Making network telemetry useful to the people making decisions.',detail:'Explored modem, network and customer datasets for a Swiss Liberty Global subsidiary, turning scattered data into views of network performance and Wi-Fi quality.',role:'Hands-on analytics & dashboards · Within a five-person team',context:'EPAM Systems',experience:'role-epam',task:'Find useful questions in the available telemetry and give client teams a clearer view of network and Wi-Fi performance.',contribution:'Explored and joined datasets, discussed priorities with stakeholders and built Looker dashboards. Worked alongside data engineers and a separate machine-learning team.',outcome:'Delivered multiple dashboards that client teams used to explore network performance. My contribution centred on data discovery and analytics; data engineers owned the ETL pipelines.',tools:'BigQuery · Looker · SQL · Python · Pandas',source:'exp_liberty_dashboards'},
 {number:'03',name:'Technology landscape assessment',category:'Liberty Global · Via EPAM',description:'A clear view of the current systems. A practical path forward.',detail:'Assessed the existing technology landscape at a regional subsidiary to support platform-transition planning.',role:'Discovery interviews · Architecture assessment · Recommendations',context:'EPAM Systems',experience:'role-epam',task:'Understand the current technical architecture, identify bottlenecks and recommend a transition path.',contribution:'Led structured interviews with engineering and operations teams, facilitated discovery workshops and synthesised findings into architecture diagrams and a presentation for the CTO.',outcome:'Delivered the assessment and transition recommendations to the CTO. The engagement concluded with advisory deliverables; implementation was outside its scope.',tools:'Stakeholder interviews · Architecture mapping · Discovery workshops',source:'exp_epam_architecture_assessment'},
];
const experience = [
 {years:'2024 — present',id:'role-opentext',company:'OpenText',role:'Lead Technical Consultant',summary:'Turning unstructured information into working AI and search solutions.',points:['Deploy and configure document intelligence proof-of-concept solutions, from infrastructure to a working demonstration.','Build Apache NiFi pipelines for extracting metadata from text, images, PDFs, audio and video.','Advise customer teams on deployment architecture and train them to build and maintain processing flows.'],tools:'Document intelligence · Apache NiFi · Kubernetes · Python'},
 {years:'2021 — 2024',id:'role-epam',company:'EPAM Systems',role:'Data Practice Consultant → Manager',summary:'Data platforms, analytics and technical consulting for Liberty Global and Zalando.',points:['Built analytical dashboards using Wi-Fi telemetry, joining datasets and visualising network performance in BigQuery and Looker.','Advised a data migration team during a transition to Amazon Redshift.','Assessed an existing technology landscape, interviewed engineering teams and presented transition recommendations.'],tools:'Data consulting · BigQuery · Looker · SQL · Amazon Redshift'},
 {years:'2021 — 2022',company:'AB Handshake',role:'Technical Consultant · Contract',summary:'Helping telecom operators connect to an anti-fraud platform.',points:['Led technical onboarding, including integration planning, architecture diagrams and customer coordination.','Recommended a product approach centred on established fraud analytics to simplify onboarding.','Introduced a ticketing system to track customer integrations.'],tools:'Technical consulting · Integration architecture · Telecom'},
 {years:'2012 — 2021',company:'Nokia',role:'Pre-sales Engineer → Solutions Consultant',summary:'Connecting customer needs with telecom software, analytics and infrastructure.',points:['Owned the OSS workstream within an IoT infrastructure migration programme.','Deployed and demonstrated video analytics technology at an industry conference.','Presented solutions, prepared technical proposals and supported customer workshops across CIS and EMEA.'],tools:'Solution architecture · OSS/BSS · IoT · Technical demonstrations'},
 {years:'2005 — 2012',company:'Siemens / Nokia Siemens Networks',role:'System Engineer → Technical Solution Manager',summary:'Hands-on delivery of telecom services across international operator environments.',points:['Commissioned telecom messaging, video calling and VoIP platforms.','Deployed a virtualised value-added services platform in Paris.','Supported operator platforms in Dubai and delivered projects across CIS and EMEA.'],tools:'Linux · VMware · Telecommunications · System engineering'},
];
---
<div class="wrap portfolio">
  <a class="portfolio-back" href="/authors/">People behind Dilum</a>
  <header class="profile-opening">
    <div class="profile-intro"><p class="eyebrow">Nikolai Khrustalev · Rotterdam, NL</p><h1>From a complex problem<br/> to a working <em>solution.</em></h1><p class="profile-lead">I help organisations turn complex information and technical challenges into practical solutions — from discovery and architecture to working proofs of concept and customer enablement.</p><div class="profile-actions"><button type="button" class="cv-button" data-print-cv><span set:html={download}/> Save CV as PDF</button><a href="https://www.linkedin.com/in/khrustalev/">LinkedIn <span set:html={arrow}/></a></div><p class="cv-note">Print-ready version · Save as PDF in your browser</p></div>
    <aside class="profile-note"><p class="eyebrow">A little context</p><p>Technical consulting.<br/> AI &amp; data solutions.<br/> Hands-on delivery.</p><div class="profile-note-bottom"><span>Based in the Netherlands</span><span>Enterprise search, data &amp; telecom</span><a href="mailto:contact@dilum.io">Let’s talk <span set:html={arrow}/></a></div></aside>
  </header>
  <nav class="profile-nav" aria-label="On this page"><a href="#projects">Selected projects</a><a href="#experience">Experience</a><a href="#about">A little about me</a><span>Scroll to explore</span></nav>
  <section id="projects" class="portfolio-section" aria-labelledby="projects-heading"><div class="section-heading"><div><p class="eyebrow">01 / Selected consulting work</p><h2 id="projects-heading">Selected projects</h2></div><p>A closer look at the problems,<br/> my contribution and the outcomes.</p></div>
    <div class="consulting-projects">{projects.map(p=><article class="consulting-project"><div class="case-index" aria-hidden="true">{p.number}</div><div class="case-content"><p class="eyebrow">{p.category}</p><h3>{p.name}</h3><p class="case-premise">{p.description}</p><p class="case-overview">{p.detail}</p><p class="case-role">{p.role}</p><details class="case-details"><summary><span>Read project notes</span><span class="expand-icon" set:html={plus}/></summary><div class="case-story"><div><h4>The brief</h4><p>{p.task}</p></div><div><h4>My contribution</h4><p>{p.contribution}</p></div><div><h4>The outcome</h4><p>{p.outcome}</p></div><p class="case-tools">{p.tools}</p><a class="project-link" href={`#${p.experience}`}>Experience at {p.context}<span set:html={arrow}/></a></div></details></div></article>)}</div>
  </section>
  <section id="experience" class="portfolio-section" aria-labelledby="experience-heading"><div class="section-heading"><div><p class="eyebrow">02 / The work behind the work</p><h2 id="experience-heading">Experience</h2></div><p>A career in connecting ideas<br/> with real-world systems.</p></div><p class="experience-hint">Open a role to see what I worked on.</p>
  <div class="experience-list">{experience.map(item=><details class="experience-entry" id={item.id}><summary><span class="experience-years">{item.years}</span><span class="experience-title"><strong>{item.company}</strong><span>{item.role}</span><span class="experience-summary">{item.summary}</span></span><span class="expand-icon" set:html={plus}/><span class="sr-only">Expand role details</span></summary><div class="experience-body"><ul>{item.points.map(point=><li>{point}</li>)}</ul><p>{item.tools}</p></div></details>)}</div></section>
  <section id="about" class="portfolio-section profile-about" aria-labelledby="about-heading"><div><p class="eyebrow">03 / Beyond the job title</p><h2 id="about-heading">Making things<br/> <em>fit together.</em></h2></div><div><p>I’m drawn to the point where a problem starts to become a working system: understanding what people need, finding the right pieces and getting them to work together.</p><p>My work has taken me from telecom infrastructure to data platforms and document intelligence. Across those different settings, the thread has stayed the same: learn the system, understand the people and make something useful.</p><p>I work across discovery, solution configuration and technical delivery, helping customer teams understand the systems they use and become confident working with them independently.</p><a class="project-link" href="mailto:contact@dilum.io">Have something in mind? Let’s talk<span set:html={arrow}/></a></div></section>
  <div class="portfolio-end"><span>Prefer a concise version?</span><button type="button" class="text-cv" data-print-cv>Save CV as PDF <span set:html={download}/></button></div>
</div>
<script>
function setupCV(){document.querySelectorAll<HTMLButtonElement>('[data-print-cv]').forEach(button=>{button.onclick=()=>{const opened=[...document.querySelectorAll<HTMLDetailsElement>('.portfolio details[open]')];document.querySelectorAll<HTMLDetailsElement>('.portfolio details').forEach(detail=>detail.open=true);window.addEventListener('afterprint',()=>{document.querySelectorAll<HTMLDetailsElement>('.portfolio details').forEach(detail=>detail.open=opened.includes(detail));},{once:true});window.print();};});}
setupCV();document.addEventListener('astro:page-load',setupCV);
</script>
