---
import '../styles/portfolio.css';
import arrow from 'lucide-static/icons/arrow-up-right.svg?raw';
import download from 'lucide-static/icons/download.svg?raw';
import plus from 'lucide-static/icons/plus.svg?raw';
const projects = [
 {number:'01',name:'2000 NL',category:'Language learning · Early access',image:'/images/2000nl/training.jpg',description:'More time learning. Less time making flashcards.',detail:'A vocabulary-learning product built around prepared dictionary content and flexible practice. Starting with Dutch, and with a problem we know first-hand.',role:'Product ownership · AI-assisted development',href:'/2000nl/',label:'Explore the product'},
 {number:'02',name:'AudioFilms',category:'Learning with video · In development',image:'/images/audiofilms/youtube-workspace.jpg',description:'Stay with the story. Practise the language.',detail:'A connected project for working with phrases in video, repeating them and looking up unfamiliar words without losing your place.',role:'Independent studio project · In development',href:'/audiofilms/',label:'About the project'},
 {number:'03',name:'Pontix',category:'Reading & translation · In development',image:'/images/pontix/icon.png',description:'Understand a word where you find it.',detail:'An early browser-extension concept for translation in context, with connections to vocabulary practice being explored.',role:'Independent studio project · Early concept',href:'/pontix/',label:'About the project'},
];
const experience = [
 {years:'2024 — present',company:'OpenText',role:'Lead Technical Consultant',summary:'Turning unstructured information into working AI and search solutions.',points:['Deploy and configure document intelligence proof-of-concept solutions, from infrastructure to a working demonstration.','Build Apache NiFi pipelines for extracting metadata from text, images, PDFs, audio and video.','Advise customer teams on deployment architecture and train them to build and maintain processing flows.'],tools:'Document intelligence · Apache NiFi · Kubernetes · Python'},
 {years:'2021 — 2024',company:'EPAM Systems',role:'Data Practice Consultant → Manager',summary:'Data platforms, analytics and technical consulting for Liberty Global and Zalando.',points:['Built analytical dashboards using Wi-Fi telemetry, joining datasets and visualising network performance in BigQuery and Looker.','Advised a data migration team during a transition to Amazon Redshift.','Assessed an existing technology landscape, interviewed engineering teams and presented transition recommendations.'],tools:'Data consulting · BigQuery · Looker · SQL · Amazon Redshift'},
 {years:'2021 — 2022',company:'AB Handshake',role:'Technical Consultant · Contract',summary:'Helping telecom operators connect to an anti-fraud platform.',points:['Led technical onboarding, including integration planning, architecture diagrams and customer coordination.','Recommended a product approach centred on established fraud analytics to simplify onboarding.','Introduced a ticketing system to track customer integrations.'],tools:'Technical consulting · Integration architecture · Telecom'},
 {years:'2012 — 2021',company:'Nokia',role:'Pre-sales Engineer → Solutions Consultant',summary:'Connecting customer needs with telecom software, analytics and infrastructure.',points:['Owned the OSS workstream within an IoT infrastructure migration programme.','Deployed and demonstrated video analytics technology at an industry conference.','Presented solutions, prepared technical proposals and supported customer workshops across CIS and EMEA.'],tools:'Solution architecture · OSS/BSS · IoT · Technical demonstrations'},
 {years:'2005 — 2012',company:'Siemens / Nokia Siemens Networks',role:'System Engineer → Technical Solution Manager',summary:'Hands-on delivery of telecom services across international operator environments.',points:['Commissioned telecom messaging, video calling and VoIP platforms.','Deployed a virtualised value-added services platform in Paris.','Supported operator platforms in Dubai and delivered projects across CIS and EMEA.'],tools:'Linux · VMware · Telecommunications · System engineering'},
];
---
<div class="wrap portfolio">
  <a class="portfolio-back" href="/authors/">People behind Dilum</a>
  <header class="profile-opening">
    <div class="profile-intro"><p class="eyebrow">Nikolai Khrustalev · Rotterdam, NL</p><h1>From a complex problem<br/> to a working <em>solution.</em></h1><p class="profile-lead">I bring together software, data and people to make useful things work. Technical consulting is my background. Building products of our own is the next chapter.</p><div class="profile-actions"><button type="button" class="cv-button" data-print-cv><span set:html={download}/> Save CV as PDF</button><a href="https://www.linkedin.com/in/khrustalev/">LinkedIn <span set:html={arrow}/></a></div><p class="cv-note">Print-ready version · Save as PDF in your browser</p></div>
    <aside class="profile-note"><p class="eyebrow">A little context</p><p>Technical consultant.<br/> Product builder.<br/> Curious by default.</p><div class="profile-note-bottom"><span>Based in the Netherlands</span><span>Building Dilum with Olesia</span><a href="mailto:contact@dilum.io">Let’s talk <span set:html={arrow}/></a></div></aside>
  </header>
  <nav class="profile-nav" aria-label="On this page"><a href="#projects">Selected projects</a><a href="#experience">Experience</a><a href="#about">A little about me</a><span>Scroll to explore</span></nav>
  <section id="projects" class="portfolio-section" aria-labelledby="projects-heading"><div class="section-heading"><div><p class="eyebrow">01 / Things we’re making</p><h2 id="projects-heading">Selected projects</h2></div><p>Our own products, built around<br/> problems we know first-hand.</p></div>
    {projects.map(p=><article class:list={['portfolio-project',{'project-compact':p.number==='03'}]}><a class:list={['project-image',{'project-icon':p.number==='03'}]} href={p.href} tabindex="-1" aria-hidden="true"><img src={p.image} alt="" loading="lazy"/></a><div class="project-copy"><p class="eyebrow">{p.number} / {p.category}</p><h3><a href={p.href}>{p.name}</a></h3><p class="project-line">{p.description}</p><p class="project-context">{p.detail}</p><p class="project-role">{p.role}</p><a class="project-link" href={p.href}>{p.label}<span set:html={arrow}/></a></div></article>)}
  </section>
  <section id="experience" class="portfolio-section" aria-labelledby="experience-heading"><div class="section-heading"><div><p class="eyebrow">02 / The work behind the work</p><h2 id="experience-heading">Experience</h2></div><p>A career in connecting ideas<br/> with real-world systems.</p></div><p class="experience-hint">Open a role to see what I worked on.</p>
  <div class="experience-list">{experience.map(item=><details class="experience-entry"><summary><span class="experience-years">{item.years}</span><span class="experience-title"><strong>{item.company}</strong><span>{item.role}</span><span class="experience-summary">{item.summary}</span></span><span class="expand-icon" set:html={plus}/><span class="sr-only">Expand role details</span></summary><div class="experience-body"><ul>{item.points.map(point=><li>{point}</li>)}</ul><p>{item.tools}</p></div></details>)}</div></section>
  <section id="about" class="portfolio-section profile-about" aria-labelledby="about-heading"><div><p class="eyebrow">03 / Beyond the job title</p><h2 id="about-heading">Making things<br/> <em>fit together.</em></h2></div><div><p>I’m drawn to the point where a problem starts to become a working system: understanding what people need, finding the right pieces and getting them to work together.</p><p>My work has taken me from telecom infrastructure to data platforms and document intelligence. Across those different settings, the thread has stayed the same: learn the system, understand the people and make something useful.</p><p>Today, Olesia and I are bringing that experience into Dilum, starting with products that help us learn languages.</p><a class="project-link" href="mailto:contact@dilum.io">Have something in mind? Let’s talk<span set:html={arrow}/></a></div></section>
  <div class="portfolio-end"><span>Prefer a concise version?</span><button type="button" class="text-cv" data-print-cv>Save CV as PDF <span set:html={download}/></button></div>
</div>
<script>
function setupCV(){document.querySelectorAll<HTMLButtonElement>('[data-print-cv]').forEach(button=>{button.onclick=()=>{const opened=[...document.querySelectorAll<HTMLDetailsElement>('.experience-entry[open]')];document.querySelectorAll<HTMLDetailsElement>('.experience-entry').forEach(detail=>detail.open=true);window.addEventListener('afterprint',()=>{document.querySelectorAll<HTMLDetailsElement>('.experience-entry').forEach(detail=>detail.open=opened.includes(detail));},{once:true});window.print();};});}
setupCV();document.addEventListener('astro:page-load',setupCV);
</script>
